# AWS ECR host only; do not include https://.
ECR_REGISTRY=000000000000.dkr.ecr.us-west-2.amazonaws.com

# Quick Build uses the lower-cased build directory as the repository name.
MAIN_SERVICE_TAG=replace-with-git-commit-tag
HEALTH_API_TAG=replace-with-git-commit-tag
ADMIN_SERVICE_TAG=replace-with-git-commit-tag
ADMIN_WEB_TAG=replace-with-git-commit-tag

# Shared internal credential used by AdminService and MainService.
PAYMENT_ADMIN_INTERNAL_TOKEN=test-payment-admin-token-change-me

# Host bindings. Keep middleware on loopback unless remote access is required.
MIDDLEWARE_BIND_IP=127.0.0.1
APP_BIND_IP=0.0.0.0

# JWT files generated for this test environment.
JWT_PRIVATE_KEY_FILE=/home/arcane/test-environment/secrets/jwt-private.pem
JWT_PUBLIC_KEYS_DIR=/home/arcane/test-environment/secrets/jwt-public-keys
